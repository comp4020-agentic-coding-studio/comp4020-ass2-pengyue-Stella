---
// A book glyph or a journal-page glyph — the only two source types this
// bibliography actually contains — sized via a prop rather than a
// caller-passed class, since Astro does not forward a caller's own scope
// hash onto a child component's root element (see PolicyIcon for the same
// fix applied to the Policies redesign).
interface Props {
  type: "book" | "article";
  size?: string;
}

const { type, size = "1.4rem" } = Astro.props;
---

<span class="citation-icon" style={{ width: size, height: size }} aria-hidden="true">
  {
    type === "book" && (
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <title>Book</title>
        <path d="M4 5.5 C4 4.4 4.9 3.5 6 3.5 H11.5 V19.5 H6 C4.9 19.5 4 18.6 4 17.5 Z" />
        <path d="M20 5.5 C20 4.4 19.1 3.5 18 3.5 H12.5 V19.5 H18 C19.1 19.5 20 18.6 20 17.5 Z" />
        <path d="M11.5 3.5 V19.5" />
      </svg>
    )
  }
  {
    type === "article" && (
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <title>Journal article</title>
        <path d="M6.5 3.5 H15 L18 6.5 V20 C18 20.6 17.6 21 17 21 H6.5 C5.9 21 5.5 20.6 5.5 20 V4.5 C5.5 3.9 5.9 3.5 6.5 3.5 Z" />
        <path d="M15 3.5 V6.5 H18" />
        <path d="M8 11 H15.5 M8 14 H15.5 M8 17 H12.5" />
      </svg>
    )
  }
</span>

<style>
  .citation-icon {
    display: inline-flex;
    flex-shrink: 0;
  }

  .citation-icon svg {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
