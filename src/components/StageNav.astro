---
// A compact four-stage jump list — deliberately not another StageJourney.
// StageJourney is the immersive plate-and-prose telling of the four stages
// (used once, on the homepage); this page already restates each stage's
// title and description in SessionsGrid's own headings, so repeating the
// large images and paragraphs a second time here would just be the same
// journey twice. This is icons and labels only, sized to get a reader to
// the right stage-group below in one glance and one click.
import { STAGES } from "../stages";
import StageIcon from "./StageIcon.astro";

const VERB: Record<number, string> = {
  1: "Measure",
  2: "Find structure",
  3: "Transform",
  4: "Predict & design",
};
---

<ol class="stage-nav" aria-label="Jump to a stage">
  {
    STAGES.map((stage) => {
      const weekStart = (stage.number - 1) * 3 + 1;
      const weekEnd = stage.number * 3;
      return (
        <li class="stage-nav__item" data-stage={stage.number}>
          <a class="stage-nav__link" href={`#stage-${stage.number}`}>
            <StageIcon stage={stage.number} class="stage-nav__icon" />
            <span class="stage-nav__body">
              <span class="stage-nav__meta">
                Stage {stage.number} · Weeks {weekStart}–{weekEnd}
              </span>
              <span class="stage-nav__verb">{VERB[stage.number]}</span>
            </span>
          </a>
        </li>
      );
    })
  }
</ol>

<style>
  .stage-nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--at-spacing-sm);
    margin: var(--at-spacing-lg) 0 var(--at-spacing-2xl);
    padding: 0;
    list-style: none;
  }

  .stage-nav__item {
    flex: 1 1 10rem;
  }

  .stage-nav__link {
    display: flex;
    align-items: center;
    gap: var(--at-spacing-sm);
    height: 100%;
    padding: var(--at-spacing-sm) var(--at-spacing-md);
    border: 1px solid var(--at-border);
    border-inline-start: 3px solid var(--stage-accent);
    border-radius: var(--at-border-radius);
    color: inherit;
    text-decoration: none;
  }

  .stage-nav__link:hover,
  .stage-nav__link:focus-visible {
    border-color: var(--stage-accent);
    box-shadow: var(--at-shadow-sm);
  }

  .stage-nav__icon {
    flex: 0 0 auto;
    width: 1.6rem;
    height: 1.6rem;
    color: var(--stage-accent);
  }

  .stage-nav__body {
    display: flex;
    flex-direction: column;
    gap: 0.15em;
    min-width: 0;
  }

  .stage-nav__meta {
    color: var(--stage-accent);
    font-family: var(--at-font-mono);
    font-size: var(--at-font-size-xs);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .stage-nav__verb {
    font-weight: 600;
  }
</style>
