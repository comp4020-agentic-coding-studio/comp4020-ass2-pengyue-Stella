---
// The Lectures section as a semester timeline, grouped by teaching stage —
// deliberately not a card grid: a lecture's place in the twelve-week
// sequence, and whether it is one of the four stage-opening "anchor"
// lectures, is the information this page exists to show. Visual pairing
// (which specimen plate, which lecture is an anchor) lives in
// src/lecture-layouts.ts, kept separate from the lecture content itself.
import { getPublishedCollection } from "astro-course-university/content";
import { withBase } from "astro-theme-university/url";
import SpecimenPlate from "./SpecimenPlate.astro";
import StageIcon from "./StageIcon.astro";
import { formatCourseDate } from "../lib/dates";
import { LECTURE_VISUALS } from "../lecture-layouts";
import { STAGES } from "../stages";

const lectures = await getPublishedCollection("lectures");
const sessions = await getPublishedCollection("sessions");
const sessionById = new Map(sessions.map((session) => [session.id, session]));

function relatedSession(lecture: (typeof lectures)[number]) {
  const ref = lecture.data.related.find((r) => r.startsWith("sessions/"));
  if (!ref) return undefined;
  return sessionById.get(ref.replace("sessions/", ""));
}

const byStage = STAGES.map((stage) => ({
  stage,
  lectures: lectures
    .filter((lecture) => LECTURE_VISUALS[lecture.data.week]?.stage === stage.number)
    .sort((a, b) => a.data.week - b.data.week),
}));
---

<ol class="lecture-timeline" aria-label="All twelve lectures, grouped by teaching stage">
  {
    byStage.map(({ stage, lectures: stageLectures }) => (
      <li class="lecture-timeline__stage" data-stage={stage.number}>
        <div class="lecture-timeline__stage-head">
          <StageIcon stage={stage.number} class="lecture-timeline__stage-icon" />
          <div>
            <p class="lecture-timeline__stage-label">
              Stage {stage.number} · {stage.title}
            </p>
            <p class="lecture-timeline__stage-desc">{stage.description}</p>
          </div>
        </div>
        <ol class="lecture-timeline__weeks">
          {stageLectures.map((lecture) => {
            const visual = LECTURE_VISUALS[lecture.data.week];
            const session = relatedSession(lecture);
            return (
              <li class="lecture-timeline__week" data-anchor={visual?.anchor ? "true" : undefined}>
                <div class="lecture-timeline__marker" aria-hidden="true">
                  <span class="lecture-timeline__week-num">{lecture.data.week}</span>
                </div>
                <div class="lecture-timeline__card">
                  {visual && (
                    <div class="lecture-timeline__plate">
                      <SpecimenPlate variant={visual.plate} frame="bleed" hideCaption hero={visual.anchor} />
                    </div>
                  )}
                  <div class="lecture-timeline__body">
                    {visual?.anchor && <p class="lecture-timeline__anchor-badge">Anchor lecture</p>}
                    <p class="lecture-timeline__meta">
                      Week {lecture.data.week} · {formatCourseDate(lecture.data.date)}
                    </p>
                    <h3 class="lecture-timeline__title">
                      <a href={withBase(`/lectures/${lecture.id}/`)}>{lecture.data.title}</a>
                    </h3>
                    {lecture.data.description && <p class="lecture-timeline__desc">{lecture.data.description}</p>}
                    <p class="lecture-timeline__tags">
                      {session && (
                        <a class="lecture-timeline__tag" href={withBase(`/sessions/${session.id}/`)}>
                          Module {session.data.week}: {session.data.title}
                        </a>
                      )}
                      {lecture.data.slides && (
                        <a class="lecture-timeline__tag lecture-timeline__tag--deck" href={withBase(lecture.data.slides)}>
                          Slide deck →
                        </a>
                      )}
                    </p>
                    <a class="lecture-timeline__cta" href={withBase(`/lectures/${lecture.id}/`)}>
                      Read the lecture →
                    </a>
                  </div>
                </div>
              </li>
            );
          })}
        </ol>
      </li>
    ))
  }
</ol>

<style>
  .lecture-timeline {
    display: flex;
    flex-direction: column;
    gap: var(--at-spacing-2xl);
    margin: var(--at-spacing-xl) 0;
    padding: 0;
    list-style: none;
  }

  .lecture-timeline__stage {
    border-top: 3px solid var(--stage-accent);
    padding-top: var(--at-spacing-lg);
  }

  .lecture-timeline__stage-head {
    display: flex;
    align-items: flex-start;
    gap: var(--at-spacing-sm);
    margin-bottom: var(--at-spacing-lg);
  }

  .lecture-timeline__stage-icon {
    flex-shrink: 0;
    width: 2rem;
    height: 2rem;
    margin-top: 0.1em;
  }

  .lecture-timeline__stage-label {
    margin: 0;
    color: var(--stage-accent);
    font-family: var(--at-font-mono);
    font-size: var(--at-font-size-sm);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .lecture-timeline__stage-desc {
    margin: 0.3em 0 0;
    max-width: 40rem;
    color: var(--at-text-secondary);
  }

  .lecture-timeline__weeks {
    display: flex;
    flex-direction: column;
    gap: var(--at-spacing-lg);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .lecture-timeline__week {
    display: grid;
    grid-template-columns: 2.75rem 1fr;
    gap: var(--at-spacing-md);
    position: relative;
  }

  .lecture-timeline__week::before {
    content: "";
    position: absolute;
    top: 2.75rem;
    bottom: calc(-1 * var(--at-spacing-lg));
    left: 1.35rem;
    width: 2px;
    background: var(--at-border);
  }

  .lecture-timeline__weeks > li:last-child::before {
    display: none;
  }

  .lecture-timeline__marker {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: var(--at-bg-alt);
    border: 2px solid var(--stage-accent);
    color: var(--stage-accent);
    font-family: var(--at-font-mono);
    font-weight: 700;
    z-index: 1;
  }

  .lecture-timeline__week[data-anchor="true"] .lecture-timeline__marker {
    background: var(--stage-accent);
    color: var(--at-white);
    box-shadow: 0 0 0 4px color-mix(in oklch, var(--stage-accent) 22%, transparent);
  }

  .lecture-timeline__card {
    display: grid;
    grid-template-columns: minmax(0, 15rem) 1fr;
    gap: var(--at-spacing-lg);
    align-items: stretch;
    padding: var(--at-spacing-md);
    border: 1px solid var(--at-border);
    border-radius: var(--at-border-radius);
    background: var(--at-bg-alt);
  }

  .lecture-timeline__week[data-anchor="true"] .lecture-timeline__card {
    grid-template-columns: minmax(0, 19rem) 1fr;
    border: 2px solid var(--stage-accent);
    background: color-mix(in oklch, var(--stage-accent) 6%, var(--at-bg-alt));
  }

  .lecture-timeline__plate {
    margin: 0;
    align-self: center;
  }

  .lecture-timeline__plate :global(.sci-plate) {
    margin: 0;
  }

  .lecture-timeline__body {
    display: flex;
    flex-direction: column;
    gap: 0.35em;
    min-width: 0;
  }

  .lecture-timeline__anchor-badge {
    margin: 0 0 0.2em;
    display: inline-flex;
    align-self: flex-start;
    padding: 0.15em 0.6em;
    border-radius: 999px;
    background: var(--stage-accent);
    color: var(--at-white);
    font-family: var(--at-font-mono);
    font-size: var(--at-font-size-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .lecture-timeline__meta {
    margin: 0;
    color: var(--stage-accent);
    font-family: var(--at-font-mono);
    font-size: var(--at-font-size-xs);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .lecture-timeline__title {
    margin: 0;
    font-size: 1.15rem;
  }

  .lecture-timeline__week[data-anchor="true"] .lecture-timeline__title {
    font-size: 1.35rem;
  }

  .lecture-timeline__title a {
    color: var(--at-heading);
    text-decoration: none;
  }

  .lecture-timeline__title a:hover,
  .lecture-timeline__title a:focus-visible {
    text-decoration: underline;
  }

  .lecture-timeline__desc {
    margin: 0;
    color: var(--at-text-secondary);
    font-size: var(--at-font-size-sm);
  }

  .lecture-timeline__tags {
    margin: 0.2em 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5em;
  }

  .lecture-timeline__tag {
    display: inline-flex;
    padding: 0.15em 0.6em;
    border: 1px solid var(--at-border);
    border-radius: 999px;
    color: var(--at-text-secondary);
    font-size: var(--at-font-size-xs);
    text-decoration: none;
  }

  .lecture-timeline__tag:hover,
  .lecture-timeline__tag:focus-visible {
    border-color: var(--stage-accent);
    color: var(--stage-accent);
  }

  .lecture-timeline__tag--deck {
    border-color: var(--stage-accent);
    color: var(--stage-accent);
    font-weight: 600;
  }

  .lecture-timeline__cta {
    margin-top: 0.4em;
    color: var(--stage-accent);
    font-weight: 600;
    font-size: var(--at-font-size-sm);
    text-decoration: none;
  }

  .lecture-timeline__cta:hover,
  .lecture-timeline__cta:focus-visible {
    text-decoration: underline;
  }

  @media (max-width: 640px) {
    .lecture-timeline__week {
      grid-template-columns: 2.25rem 1fr;
    }

    .lecture-timeline__week::before {
      top: 2.25rem;
      left: 1.1rem;
    }

    .lecture-timeline__marker {
      width: 2.25rem;
      height: 2.25rem;
      font-size: var(--at-font-size-sm);
    }

    .lecture-timeline__card,
    .lecture-timeline__week[data-anchor="true"] .lecture-timeline__card {
      grid-template-columns: 1fr;
    }

    .lecture-timeline__stage-desc {
      max-width: none;
    }
  }
</style>
