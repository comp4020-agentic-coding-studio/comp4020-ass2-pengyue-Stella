---
// A staff directory, not a card grid: two people don't fill a 2-column
// grid convincingly, and neither has a real photo on file, so a card with
// an empty image slot would read as a missing photo rather than a design
// choice. Each person gets a full-width panel instead, led by a
// typographic monogram (initials, never a stand-in photo) and their real
// contact details pulled out where a reader actually needs them.
import { getPublishedCollection } from "astro-course-university/content";
import { withBase } from "astro-theme-university/url";

const people = await getPublishedCollection("people");

const roleOrder: Record<string, number> = {
  convenor: 0,
  tutor: 1,
  guest: 2,
  other: 3,
};

const roleLabels: Record<string, string> = {
  convenor: "Convenor",
  tutor: "Tutor",
  guest: "Guest lecturer",
  other: "",
};

function initials(title: string): string {
  const words = title.trim().split(/\s+/);
  const first = words.at(0)?.[0] ?? "";
  const last = words.length > 1 ? (words.at(-1)?.[0] ?? "") : "";
  return (first + last).toUpperCase();
}

const visible = people.slice().sort((a, b) => {
  const ra = roleOrder[a.data.role ?? "other"] ?? 99;
  const rb = roleOrder[b.data.role ?? "other"] ?? 99;
  if (ra !== rb) return ra - rb;
  return a.data.title.localeCompare(b.data.title);
});
---

<ul class="people-roster" aria-label="Everyone teaching this course">
  {
    visible.map((person) => (
      <li class="people-roster__row" data-role={person.data.role ?? "other"}>
        <div class="people-roster__monogram" aria-hidden="true">
          {initials(person.data.title)}
        </div>
        <div class="people-roster__body">
          <div class="people-roster__heading">
            <h2 class="people-roster__name">
              <a href={withBase(`/people/${person.id}/`)}>{person.data.title}</a>
            </h2>
            {person.data.role && roleLabels[person.data.role] && (
              <span class="people-roster__role">{roleLabels[person.data.role]}</span>
            )}
          </div>
          {person.data.affiliation && <p class="people-roster__affiliation">{person.data.affiliation}</p>}
          <p class="people-roster__desc">{person.data.description}</p>
          <p class="people-roster__contact">
            {person.data.email && <a href={`mailto:${person.data.email}`}>{person.data.email}</a>}
            {person.data.contact && <span>{person.data.contact}</span>}
          </p>
          <a class="people-roster__cta" href={withBase(`/people/${person.id}/`)}>
            Full profile, consultation hours and escalation path →
          </a>
        </div>
      </li>
    ))
  }
</ul>

<style>
  .people-roster {
    display: flex;
    flex-direction: column;
    gap: var(--at-spacing-lg);
    margin: var(--at-spacing-xl) 0;
    padding: 0;
    list-style: none;
  }

  .people-roster__row {
    display: grid;
    grid-template-columns: 6rem 1fr;
    gap: var(--at-spacing-lg);
    padding: var(--at-spacing-lg);
    border: 1px solid var(--at-border);
    border-radius: var(--at-border-radius);
    background: var(--at-bg-alt);
  }

  .people-roster__monogram {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 6rem;
    height: 6rem;
    border-radius: 50%;
    background: var(--at-primary);
    color: var(--at-white);
    font-family: var(--at-font-mono);
    font-size: 1.9rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .people-roster__row[data-role="tutor"] .people-roster__monogram {
    background: var(--at-secondary);
  }

  .people-roster__row[data-role="guest"] .people-roster__monogram,
  .people-roster__row[data-role="other"] .people-roster__monogram {
    background: var(--at-tertiary, var(--at-secondary));
  }

  .people-roster__body {
    display: flex;
    flex-direction: column;
    gap: 0.3em;
    min-width: 0;
  }

  .people-roster__heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.6em;
  }

  .people-roster__name {
    margin: 0;
    font-size: 1.4rem;
  }

  .people-roster__name a {
    color: var(--at-heading);
    text-decoration: none;
  }

  .people-roster__name a:hover,
  .people-roster__name a:focus-visible {
    text-decoration: underline;
  }

  .people-roster__role {
    padding: 0.15em 0.6em;
    border-radius: 999px;
    background: color-mix(in oklch, var(--at-primary) 12%, transparent);
    color: var(--at-primary);
    font-family: var(--at-font-mono);
    font-size: var(--at-font-size-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .people-roster__row[data-role="tutor"] .people-roster__role {
    background: color-mix(in oklch, var(--at-secondary) 14%, transparent);
    color: var(--at-secondary);
  }

  .people-roster__affiliation {
    margin: 0;
    color: var(--at-text-secondary);
    font-size: var(--at-font-size-sm);
  }

  .people-roster__desc {
    margin: 0.3em 0 0;
  }

  .people-roster__contact {
    margin: 0.2em 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.3em 1em;
    color: var(--at-text-secondary);
    font-size: var(--at-font-size-sm);
  }

  .people-roster__cta {
    margin-top: 0.4em;
    align-self: flex-start;
    color: var(--at-primary);
    font-weight: 600;
    font-size: var(--at-font-size-sm);
    text-decoration: none;
  }

  .people-roster__row[data-role="tutor"] .people-roster__cta {
    color: var(--at-secondary);
  }

  .people-roster__cta:hover,
  .people-roster__cta:focus-visible {
    text-decoration: underline;
  }

  @media (max-width: 640px) {
    .people-roster__row {
      grid-template-columns: 1fr;
      justify-items: start;
    }

    .people-roster__monogram {
      width: 4rem;
      height: 4rem;
      font-size: 1.4rem;
    }
  }
</style>
