---
// The flagship page: the one place the site states its thesis outright — but
// as a practical course guide, not a second landing page. The homepage
// carries the prospective-student pitch (specimen photography, the
// four-stage journey, the two instruments); this page exists for someone who
// already wants the operational answer — who it's for, what it assumes, how
// a week actually runs, and how the graded work maps onto what you're meant
// to be able to do by the end. Built as a plain .astro page (like the
// homepage) so the two-column claim section below can sit outside
// ContentLayout's single prose column; everything else is ordinary prose.
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import { getPublishedCollection } from "astro-course-university/content";
import { withBase } from "astro-theme-university/url";
import SpecimenPlate from "../../components/SpecimenPlate.astro";
import { sessionLabels, siteConfig } from "../../site-config";
import "../../styles/scientific.css";
import "../../styles/nav.css";

const title = "Course overview";
const description =
  "What SLOP3358 is, who it's for, what you should already know, and what you should be able to do by the end of it.";

// The measurable quantities and standard models the course actually builds
// facility with. Kept as the same real terms the course uses throughout —
// this isn't new content, just no longer framed as "vocabulary" to learn for
// its own sake: it's the working toolkit the rest of this page describes.
const TOOLKIT = [
  "storage modulus, G′",
  "loss modulus, G″",
  "flow curve",
  "transport coefficient",
  "glass transition, Tg",
  "percolation threshold",
];

const OUTCOMES = [
  "Identify which physical state (fluid, viscoelastic solid, amorphous glass, crystalline solid) a given cooked or processed food occupies, and justify that classification from its mechanical or thermal behaviour.",
  "Select and apply an appropriate flow model (Newtonian, power-law, Herschel–Bulkley), thermal model (sensible or latent heat, Biot-number regime), or network model (percolation, Gordon–Taylor glass transition) to a specified food material, stating the governing equation and every variable in it.",
  "Fit a model to a dataset, report a goodness-of-fit measure, and read that measure honestly — recognising when a model does not fit well rather than reporting a fit regardless.",
  "State, for any quantitative claim you make about a food material, whether the underlying value is measured, drawn from published literature, or a labelled illustrative/synthetic estimate — and why that distinction matters.",
  "Use a validated model in reverse: given a target texture or shelf-life outcome, propose a process or formulation change and justify it from the model rather than from taste alone.",
];

// Which assessment(s) exercise which outcome(s) above, by index into
// OUTCOMES. This linkage is editorial judgement — the week, weight and title
// underneath it are fetched live from the assessments collection just below,
// so this table can never quote a stale number.
const ASSESSMENT_OUTCOMES: { id: string; outcomes: number[]; note: string }[] = [
  {
    id: "material-characterisation-report",
    outcomes: [1, 3],
    note: "Marked 35% on correct use of a Stage 1 governing model and 45% combined on honest assumptions and real, labelled sources — outcomes 2 and 4 above, applied to one material you choose yourself.",
  },
  {
    id: "modelling-problem-sets",
    outcomes: [1],
    note: "Half the mark is correct application of the relevant transport, kinetics or phase-transition model — outcome 2 — with the rest on shown working and a discussion of the model's limits.",
  },
  {
    id: "laboratory-portfolio",
    outcomes: [0, 2, 3],
    note: "Both instruments are marked on fit quality and state interpretation (outcomes 1 and 3), and 15% of the mark is awarded for stating assumptions and data provenance throughout (outcome 4).",
  },
  {
    id: "inverse-material-design-project",
    outcomes: [4],
    note: "The capstone: a validated model run backwards from a target outcome, judged holistically on whether that target was genuinely measurable and the inversion honestly reported (outcome 5, drawing on all the others).",
  },
];

const assessments = (await getPublishedCollection("assessments")).slice().sort((a, b) => a.data.week - b.data.week);
const assessmentById = new Map(assessments.map((a) => [a.id, a]));
---

<ContentLayout title={title} description={description} {...siteConfig}>
  <section class="claim">
    <div class="claim__text">
      <h2>What this course is</h2>
      <p>
        SLOP3358 treats Chinese cooking as one connected teaching laboratory, not a set of decorative examples: the
        same soft-matter physics runs through all twelve weekly{" "}
        <a href={withBase("/sessions/")}>{sessionLabels.plural.toLowerCase()}</a>, grouped into four three-{sessionLabels.singular.toLowerCase()}
        stages. Across them you move from describing a food's texture in words to measuring it, explaining it,
        predicting it and redesigning it — in the same terms a materials scientist would use for any soft material.
        The course reuses standard, established models — Newtonian and power-law flow, Fourier
        conduction, Arrhenius kinetics, Flory–Stockmayer percolation, the Gordon–Taylor equation — rather than
        inventing new theory. Depth comes from applying real models honestly to real food systems, not from piling
        on unfamiliar terms.
      </p>
      <p class="claim__toolkit-label">Measures and models this course puts to use:</p>
      <ul class="claim__toolkit" aria-label="Measures and models this course uses">
        {TOOLKIT.map((term) => <li>{term}</li>)}
      </ul>
    </div>
    <div class="claim__plate">
      <SpecimenPlate variant="rheometer-rig" frame="framed" />
    </div>
  </section>

  <section class="overview-section">
    <h2>Who it's for</h2>
    <p>
      A third-year student who wants to see thermodynamics, transport and rheology applied to something concrete
      rather than another abstract system — no prior cooking experience, food science background, or
      Chinese-language knowledge is assumed. Every food system used in the course is introduced from first
      principles, in translation, before any model is applied to it.
    </p>
    <aside class="prereq" aria-label="Prerequisites">
      <p class="prereq__label">Before you start</p>
      <p>
        A second-year course covering thermodynamics and either physical chemistry or continuum mechanics
        (equivalent to a standard undergraduate thermodynamics-and-kinetics sequence), plus enough calculus to be
        comfortable with ordinary differential equations and basic curve fitting.
      </p>
    </aside>
  </section>

  <section class="outcomes">
    <h2>Learning outcomes</h2>
    <p>By the end of SLOP3358, you should be able to:</p>
    <ol class="outcomes__list">
      {
        OUTCOMES.map((text, i) => (
          <li class="outcomes__item">
            <span class="outcomes__num" aria-hidden="true">
              {i + 1}
            </span>
            <p>{text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="overview-section">
    <h2>How the course runs</h2>
    <p>
      Each week pairs one written <a href={withBase("/sessions/")}>{sessionLabels.singular.toLowerCase()}</a> — the
      material itself — with a{" "}
      <a href={withBase("/lectures/")}>lecture</a> that applies it through a demonstration, comparison or worked
      example rather than repeating it — twelve of each, run in the fixed four-stage order set out in the{" "}
      {sessionLabels.plural.toLowerCase()} index. Rather than
      a simulation for every {sessionLabels.singular.toLowerCase()}, the course concentrates its interactive work
      into two instruments — the Virtual Rheometer and the Crispness Phase Diagram, both introduced mid-course and
      both run entirely in the browser — used repeatedly across the <a href={withBase("/labs/")}>Labs</a> and the
      Laboratory Portfolio, rather than once each and set aside.
    </p>
  </section>

  <section class="overview-section">
    <h2>Expected workload</h2>
    <p>
      The reading and the lecture for a given week are sized to be worked through in that week, alongside whichever
      staged assessment is currently open — the four pieces of graded work land in weeks 4, 10, 11 and 12, so the
      heavier sustained effort concentrates there rather than spreading evenly. The two instruments are meant to be
      returned to more than once before the Laboratory Portfolio is due, not used in a single sitting.
    </p>
  </section>

  <section class="overview-section">
    <h2>Tools and equipment</h2>
    <p>
      A computer with a modern browser is all this course requires. Both virtual instruments run entirely
      client-side — nothing to install, no account, no special software or hardware beyond that.
    </p>
  </section>

  <section class="assess-map">
    <h2>How assessment supports these outcomes</h2>
    <p>
      Each piece of graded work is built to exercise specific outcomes above, not to test recall of the
      {" "}{sessionLabels.plural.toLowerCase()} in general — see <a href={withBase("/assessments/")}>Assessment</a> for
      every brief, spec and marking criterion in full.
    </p>
    <ol class="assess-map__list">
      {
        ASSESSMENT_OUTCOMES.map(({ id, outcomes, note }) => {
          const assessment = assessmentById.get(id);
          if (!assessment) return null;
          const outcomeLabel = outcomes.map((i) => i + 1).join(" and ");
          return (
            <li class="assess-map__item">
              <a href={withBase(`/assessments/${assessment.id}/`)} class="assess-map__title">
                {assessment.data.title}
              </a>
              <p class="assess-map__meta">
                Week {assessment.data.week} · {assessment.data.weight}% · outcome{outcomes.length > 1 ? "s" : ""}{" "}
                {outcomeLabel}
              </p>
              <p class="assess-map__note">{note}</p>
            </li>
          );
        })
      }
    </ol>
  </section>
</ContentLayout>

<style>
  .claim {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 20rem);
    gap: var(--at-spacing-2xl);
    align-items: start;
    margin: 0 0 var(--at-spacing-2xl);
  }

  .claim__toolkit-label {
    margin: var(--at-spacing-md) 0 0;
    color: var(--at-text-secondary);
    font-family: var(--at-font-mono);
    font-size: var(--at-font-size-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .claim__toolkit {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5em;
    margin: var(--at-spacing-sm) 0 0;
    padding: 0;
    list-style: none;
  }

  .claim__toolkit li {
    padding: 0.2em 0.7em;
    border: 1px solid var(--at-border);
    border-radius: 999px;
    color: var(--at-text-secondary);
    background: var(--at-bg-alt);
    font-family: var(--at-font-mono);
    font-size: var(--at-font-size-xs);
  }

  .claim__plate {
    position: sticky;
    top: var(--at-spacing-lg);
  }

  .overview-section {
    margin: var(--at-spacing-2xl) 0;
  }

  .prereq {
    margin: var(--at-spacing-lg) 0 0;
    padding: var(--at-spacing-lg);
    border-left: 4px solid var(--at-secondary);
    background: var(--at-bg-alt);
    border-radius: 0 var(--at-border-radius) var(--at-border-radius) 0;
  }

  .prereq__label {
    margin: 0 0 0.4em;
    color: var(--at-secondary);
    font-family: var(--at-font-mono);
    font-size: var(--at-font-size-sm);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .prereq p:last-child {
    margin-bottom: 0;
  }

  .outcomes {
    margin: var(--at-spacing-2xl) 0;
  }

  .outcomes__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--at-spacing-lg);
    margin: var(--at-spacing-lg) 0 0;
    padding: 0;
    list-style: none;
  }

  .outcomes__item {
    display: grid;
    grid-template-columns: 2.4rem 1fr;
    gap: var(--at-spacing-sm);
    align-items: start;
  }

  .outcomes__num {
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--at-font-mono);
    font-size: 1.6rem;
    font-weight: 700;
    color: color-mix(in oklch, var(--at-heading) 18%, transparent);
  }

  .outcomes__item p {
    margin: 0;
  }

  .assess-map {
    margin: var(--at-spacing-2xl) 0;
  }

  .assess-map__list {
    display: flex;
    flex-direction: column;
    gap: var(--at-spacing-lg);
    margin: var(--at-spacing-lg) 0 0;
    padding: 0;
    list-style: none;
  }

  .assess-map__item {
    padding-inline-start: var(--at-spacing-lg);
    border-inline-start: 3px solid var(--at-secondary);
  }

  .assess-map__title {
    font-weight: 600;
  }

  .assess-map__meta {
    margin: 0.2em 0 0.4em;
    color: var(--stage-accent, var(--at-secondary));
    font-family: var(--at-font-mono);
    font-size: var(--at-font-size-xs);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .assess-map__note {
    margin: 0;
    color: var(--at-text-secondary);
    font-size: var(--at-font-size-sm);
  }

  @media (max-width: 900px) {
    .claim {
      grid-template-columns: 1fr;
    }

    .claim__plate {
      position: static;
    }
  }

  @media (max-width: 640px) {
    .outcomes__list {
      grid-template-columns: 1fr;
    }
  }
</style>
