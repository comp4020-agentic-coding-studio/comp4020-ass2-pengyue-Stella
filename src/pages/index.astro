---
import { Image } from "astro:assets";
import { getPublishedCollection } from "astro-course-university/content";
import Card from "astro-theme-university/components/Card.astro";
import CardGrid from "astro-theme-university/components/CardGrid.astro";
import BaseLayout from "astro-theme-university/layouts/BaseLayout.astro";
import { withBase } from "astro-theme-university/url";
import AssessmentBars from "../components/AssessmentBars.astro";
import InstrumentTeaser from "../components/InstrumentTeaser.astro";
import SpecimenPlate from "../components/SpecimenPlate.astro";
import StageJourney from "../components/StageJourney.astro";
import heroPhoto from "../assets/images/photos/noodle-dough.webp";
import { courseMeta } from "../course-config";
import { sessionLabels, siteConfig } from "../site-config";
import { STAGES } from "../stages";
import "../styles/scientific.css";

const sessions = (await getPublishedCollection("sessions")).slice().sort((a, b) => a.data.week - b.data.week);
---

<BaseLayout title={`${courseMeta.code}: ${courseMeta.title}`} description={courseMeta.description} {...siteConfig}>
  <Fragment slot="hero">
    <section class="at-hero home-hero" aria-label={courseMeta.title}>
      <Image
        src={heroPhoto}
        alt=""
        widths={[768, 1536, 2560]}
        sizes="100vw"
        format="webp"
        loading="eager"
        fetchpriority="high"
        class="at-hero-image"
      />
      <div class="at-hero-content home-hero__content">
        <p class="home-hero__kicker">
          {courseMeta.code} · {courseMeta.session} {courseMeta.year}
        </p>
        <h1 class="at-hero-title">{courseMeta.title}</h1>
        <p class="home-hero__lead">{courseMeta.description}</p>
        <ul class="home-hero__tags" aria-label="Course tags">
          {courseMeta.tags.map((tag) => <li>{tag}</li>)}
        </ul>
        <div class="home-hero__actions">
          <a class="home-hero__cta home-hero__cta--primary" href={withBase("/sessions/")}>
            Explore the {sessionLabels.plural.toLowerCase()}
          </a>
          <a class="home-hero__cta" href={withBase("/labs/")}>
            Try the instruments
          </a>
        </div>
      </div>
    </section>
  </Fragment>

  <h2>The claim</h2>
  <p>
    Every question this course asks starts from the same premise: a food's
    texture is a measurable material property, governed by the same
    thermodynamics, transport equations and rheology used to characterise any
    soft material — not a matter of taste, and not beyond the reach of a
    model. A boba pearl's "QQ" bounce is a storage-to-loss modulus ratio. A
    spring roll's crunch is a material below its glass transition. Twelve
    modules build the vocabulary and the tools to say exactly which
    property, and why.
  </p>

  <h2>A journey through matter, structure and transformation</h2>
  <p>
    The teaching period runs in four stages, each three modules long, each
    building directly on the last — measurement, then structure, then
    transformation, then prediction and inverse design. Each stage's
    specimen is the material it's named for:
  </p>
  <StageJourney />

  <h2>Twelve modules, at a glance</h2>
  <p>
    The same four stages, laid out week by week. Follow a module link straight
    into its content, or read the full curriculum map in {sessionLabels.plural}.
  </p>
  <ol class="week-track" aria-label="All twelve modules across four stages">
    {
      STAGES.map((stage) => (
        <li class="week-track__stage" data-stage={stage.number}>
          <p class="week-track__stage-label">
            Stage {stage.number} · {stage.title}
          </p>
          <ol class="week-track__weeks">
            {sessions
              .filter((session) => session.data.stage === stage.number)
              .map((session) => (
                <li>
                  <a href={withBase(`/sessions/${session.id}/`)}>
                    <span class="week-track__week">Week {session.data.week}</span>
                    <span class="week-track__title">{session.data.title}</span>
                  </a>
                </li>
              ))}
          </ol>
        </li>
      ))
    }
  </ol>

  <h2>Two instruments, not two dozen</h2>
  <p>
    Rather than one simulation per module, the course concentrates its
    interactive work into two instruments used repeatedly across the
    Laboratory Portfolio. Both are built to the same honesty standard as the
    written modules — labelled assumptions, visible fit quality, no invented
    data.
  </p>
  <div class="instrument-showcase">
    <InstrumentTeaser title="Virtual Rheometer" href="/labs/virtual-rheometer/">
      <Fragment slot="image">
        <SpecimenPlate variant="rheometer-rig" frame="bleed" hideCaption />
      </Fragment>
      Sweep shear rate across a simulated soft material, fit Newtonian,
      power-law and Herschel-Bulkley models to the flow curve, and read the
      residual plot to see which fit actually holds.
    </InstrumentTeaser>
    <InstrumentTeaser title="Crispness Phase Diagram" href="/labs/crispness-phase-diagram/">
      <Fragment slot="image">
        <SpecimenPlate variant="crispy" frame="bleed" hideCaption />
      </Fragment>
      Move a specimen through a temperature-moisture state diagram and watch
      it cross from the glassy, crisp region into the rubbery, softened one
      as it absorbs humidity.
    </InstrumentTeaser>
  </div>

  <h2>Where the marks are</h2>
  <p>
    Assessment is staged the same way the curriculum is: earlier, lower-stakes
    work builds toward the two pieces that carry most of the mark.
  </p>
  <AssessmentBars />

  <h2>Where to go next</h2>
  <CardGrid columns={2}>
    <Card title="Course overview" href="/overview/">
      <p>Thesis, learning outcomes, prerequisites, and how the four stages fit together.</p>
    </Card>
    <Card title={sessionLabels.plural} href="/sessions/">
      <p>All twelve teaching modules, grouped by stage.</p>
    </Card>
    <Card title="Assessment" href="/assessments/">
      <p>What is marked, what it is worth, and when it is due.</p>
    </Card>
    <Card title="People" href="/people/">
      <p>Who teaches the course and how to reach them.</p>
    </Card>
  </CardGrid>
</BaseLayout>

<style>
  .home-hero {
    min-height: 32rem;
  }

  .home-hero__content {
    gap: var(--at-spacing-sm);
    padding-block-end: var(--at-spacing-2xl);
  }

  .home-hero__kicker {
    grid-column: content;
    margin: 0;
    color: var(--at-white);
    font-family: var(--at-font-mono);
    font-size: var(--at-font-size-sm);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    opacity: 0.85;
  }

  .home-hero__lead {
    grid-column: content;
    max-width: 46rem;
    margin: 0;
    color: var(--at-white);
    font-size: 1.15rem;
    text-shadow: 0 1px 2px rgb(0 0 0 / 55%);
  }

  .home-hero__tags {
    display: flex;
    flex-wrap: wrap;
    grid-column: content;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .home-hero__tags li {
    padding: 0.25rem 0.65rem;
    border: 1px solid rgb(255 255 255 / 35%);
    border-radius: 999px;
    color: var(--at-white);
    background: rgb(255 255 255 / 10%);
    font-size: 0.85rem;
  }

  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    grid-column: content;
    gap: var(--at-spacing-sm);
    margin-block-start: var(--at-spacing-sm);
  }

  .home-hero__cta {
    padding: 0.65rem 1.25rem;
    border: 1px solid rgb(255 255 255 / 55%);
    border-radius: var(--at-border-radius);
    color: var(--at-white);
    font-weight: 600;
    text-decoration: none;
  }

  .home-hero__cta:hover,
  .home-hero__cta:focus-visible {
    background: rgb(255 255 255 / 12%);
  }

  .home-hero__cta--primary {
    border-color: var(--at-primary);
    background: var(--at-primary);
    color: var(--at-heading);
  }

  .home-hero__cta--primary:hover,
  .home-hero__cta--primary:focus-visible {
    background: color-mix(in oklch, var(--at-primary) 85%, white 15%);
  }

  .week-track {
    display: flex;
    flex-direction: column;
    gap: var(--at-spacing-lg);
    margin: var(--at-spacing-xl) 0;
    padding: 0;
    list-style: none;
  }

  .week-track__stage {
    padding-top: var(--at-spacing-sm);
    border-top: 3px solid var(--stage-accent);
  }

  .week-track__stage-label {
    margin: 0 0 var(--at-spacing-sm);
    color: var(--stage-accent);
    font-family: var(--at-font-mono);
    font-size: var(--at-font-size-sm);
    font-weight: 600;
  }

  .week-track__weeks {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: var(--at-spacing-sm);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .week-track__weeks a {
    display: flex;
    flex-direction: column;
    gap: 0.2em;
    height: 100%;
    padding: var(--at-spacing-sm) var(--at-spacing-md);
    border: 1px solid var(--at-border);
    border-radius: var(--at-border-radius);
    color: inherit;
    text-decoration: none;
  }

  .week-track__weeks a:hover,
  .week-track__weeks a:focus-visible {
    border-color: var(--stage-accent);
    box-shadow: var(--at-shadow-sm);
  }

  .week-track__week {
    color: var(--stage-accent);
    font-family: var(--at-font-mono);
    font-size: var(--at-font-size-xs);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .week-track__title {
    font-size: var(--at-font-size-sm);
  }

  .instrument-showcase {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: var(--at-spacing-lg);
    margin: var(--at-spacing-xl) 0;
  }
</style>
