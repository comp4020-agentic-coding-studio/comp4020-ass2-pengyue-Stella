---
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import { withBase } from "astro-theme-university/url";
import SpecimenPlate from "../../components/SpecimenPlate.astro";
import { siteConfig } from "../../site-config";
import "../../styles/scientific.css";
---

<ContentLayout
  title="Labs"
  description="The two virtual instruments the Laboratory Portfolio is built from."
  {...siteConfig}
>
  <p>
    Two instruments run entirely in the browser, each built from the models a
    module already introduced. Both feed directly into the Laboratory
    Portfolio (worth 25% of the course), which asks you to use each one and
    report what you found rather than describe it in the abstract.
  </p>
  <ul class="labs-list">
    <li class="labs-list__item">
      <div class="labs-list__plate">
        <SpecimenPlate variant="rheometer-rig" frame="framed" hideCaption />
      </div>
      <div class="labs-list__content">
        <span class="labs-list__kicker">Instrument 01 · steady shear</span>
        <h2><a href={withBase("/labs/virtual-rheometer/")}>Virtual Rheometer</a></h2>
        <p>
          Fit Newtonian, power-law and Herschel-Bulkley models to a specimen's
          flow curve and read the residual plot. Builds on <a href={withBase("/sessions/02-rheology-i-flow-behaviour/")}>Module 2</a> and is used directly in <a href={withBase("/sessions/10-building-predictive-models/")}>Module 10</a>.
        </p>
      </div>
    </li>
    <li class="labs-list__item">
      <div class="labs-list__plate">
        <SpecimenPlate variant="crispy" frame="framed" hideCaption />
      </div>
      <div class="labs-list__content">
        <span class="labs-list__kicker">Instrument 02 · state diagram</span>
        <h2><a href={withBase("/labs/crispness-phase-diagram/")}>Crispness Phase Diagram</a></h2>
        <p>
          Place a specimen at a storage humidity, run moisture uptake forward
          in time, and read its stability margin off a temperature-moisture
          state diagram. Builds on <a href={withBase("/sessions/09-phase-transitions-in-cooking/")}>Module 9</a> and <a href={withBase("/sessions/11-the-crispness-design-space/")}>Module 11</a>, and is the centrepiece of the lecture <a href={withBase("/decks/crispness-metastable/")}><em>Crispness Is a Metastable State</em></a>.
        </p>
      </div>
    </li>
  </ul>
</ContentLayout>

<style>
  .labs-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--at-spacing-2xl);
  }

  .labs-list__item {
    display: flex;
    align-items: center;
    gap: var(--at-spacing-xl);
  }

  .labs-list__item:nth-child(even) {
    flex-direction: row-reverse;
  }

  .labs-list__plate {
    flex: 0 0 38%;
    min-width: 0;
  }

  .labs-list__content {
    flex: 1 1 auto;
    min-width: 0;
    padding-inline-start: var(--at-spacing-lg);
    border-inline-start: 3px solid var(--at-secondary);
  }

  .labs-list__item:nth-child(even) .labs-list__content {
    padding-inline-start: 0;
    padding-inline-end: var(--at-spacing-lg);
    border-inline-start: none;
    border-inline-end: 3px solid var(--at-secondary);
  }

  .labs-list__kicker {
    display: block;
    margin-bottom: var(--at-spacing-xs);
    font-family: var(--at-font-mono);
    font-size: var(--at-font-size-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--at-secondary);
  }

  .labs-list h2 {
    margin: 0 0 var(--at-spacing-xs);
  }

  .labs-list p {
    margin-bottom: 0;
  }

  @media (max-width: 900px) {
    .labs-list__item,
    .labs-list__item:nth-child(even) {
      flex-direction: column;
      align-items: stretch;
    }

    .labs-list__plate {
      flex-basis: auto;
    }

    .labs-list__content,
    .labs-list__item:nth-child(even) .labs-list__content {
      padding-inline: var(--at-spacing-lg) 0;
      border-inline-end: none;
      border-inline-start: 3px solid var(--at-secondary);
    }
  }
</style>
