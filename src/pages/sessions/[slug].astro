---
import { render } from "astro:content";
import { getPublishedCollection } from "astro-course-university/content";
import RelatedContent from "astro-course-university/components/RelatedContent.astro";
import SpecList from "astro-course-university/components/SpecList.astro";
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import { withBase } from "astro-theme-university/url";
import StageIcon from "../../components/StageIcon.astro";
import SpecimenPlate from "../../components/SpecimenPlate.astro";
import TeachingTeam from "../../components/TeachingTeam.astro";
import { formatCourseDate } from "../../lib/dates";
import { DEFAULT_MODULE_VISUAL, MODULE_VISUALS } from "../../module-layouts";
import { graphCollections, sessionLabels, siteConfig } from "../../site-config";
import { stageInfo } from "../../stages";
import "../../styles/scientific.css";

export async function getStaticPaths() {
  const sessions = await getPublishedCollection("sessions");
  const ordered = sessions.slice().sort((a, b) => a.data.week - b.data.week);
  return ordered.map((session, index) => ({
    params: { slug: session.id },
    props: { session, previous: ordered[index - 1], next: ordered[index + 1] },
  }));
}

const { session, previous, next } = Astro.props;
const { Content } = await render(session);
const stage = stageInfo(session.data.stage);
const visual = MODULE_VISUALS[session.id] ?? DEFAULT_MODULE_VISUAL;
---

<ContentLayout
  title={`Week ${session.data.week} ${sessionLabels.singular}: ${session.data.title}`}
  description={session.data.description}
  {...siteConfig}
>
  <div data-stage={stage.number} data-layout={visual.layout}>
    <div class="module-hero">
      <a class="stage-badge" href={withBase("/sessions/")}>
        <StageIcon stage={stage.number} />
        Stage {stage.number} · <strong>{stage.title}</strong>
      </a>
      <span class="module-hero__date">
        Week {session.data.week} · {formatCourseDate(session.data.date)}
      </span>
    </div>
    {
      visual.plate && (
        <div class="module-visual">
          <SpecimenPlate variant={visual.plate} frame="framed" hero />
          {visual.instrument && (
            <a class="module-instrument-callout" href={withBase(visual.instrument.href)}>
              <span class="module-instrument-callout__kicker">Try it in the lab</span>
              <span class="module-instrument-callout__title">{visual.instrument.title}</span>
              <span class="module-instrument-callout__link">Open the instrument →</span>
            </a>
          )}
        </div>
      )
    }
    <Content />
    <SpecList spec={session.data.spec}>
      What you bring to the session. Written so a reader can tell whether it
      has been met without asking you.
    </SpecList>
    <TeachingTeam teachers={session.data.teachers} />
    <RelatedContent entry={session} collections={graphCollections} />
    <nav class="module-pager" aria-label="Module sequence">
      {
        previous ? (
          <a href={withBase(`/sessions/${previous.id}/`)} rel="prev">
            ← Week {previous.data.week}: {previous.data.title}
          </a>
        ) : (
          <span />
        )
      }
      {
        next ? (
          <a href={withBase(`/sessions/${next.id}/`)} rel="next">
            Week {next.data.week}: {next.data.title} →
          </a>
        ) : (
          <span />
        )
      }
    </nav>
  </div>
</ContentLayout>

<style>
  .module-pager {
    display: flex;
    justify-content: space-between;
    gap: var(--at-spacing-lg);
    margin-top: var(--at-spacing-2xl);
    padding-top: var(--at-spacing-lg);
    border-top: 1px solid var(--at-divider);
  }

  .module-pager a {
    max-width: 46%;
  }

  @media (max-width: 640px) {
    .module-pager {
      flex-direction: column;
      gap: var(--at-spacing-sm);
    }

    .module-pager a {
      max-width: 100%;
    }
  }
</style>
