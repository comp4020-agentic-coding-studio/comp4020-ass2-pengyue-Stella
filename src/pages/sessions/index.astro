---
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import { withBase } from "astro-theme-university/url";
import SessionsGrid from "../../components/SessionsGrid.astro";
import StageNav from "../../components/StageNav.astro";
import { sessionLabels, siteConfig } from "../../site-config";
import "../../styles/scientific.css";
---

<ContentLayout
  title={sessionLabels.plural}
  description="Twelve teaching modules across four stages: measuring edible matter, then its structures, its transformations under cooking, and finally how to predict and design it."
  {...siteConfig}
>
  <p>
    This is the curriculum map: measurement leads to structure, structure to
    transformation, transformation to prediction and inverse design. Each
    stage assumes the vocabulary the last one built — read them in order the
    first time, then use the module pager and the links below each module to
    move forward or back once you know the ground. For the fuller telling of
    this same progression, with a specimen for each stage, see the{" "}
    <a href={withBase("/")}>course overview journey</a>.
  </p>
  <StageNav />
  <SessionsGrid />
</ContentLayout>
