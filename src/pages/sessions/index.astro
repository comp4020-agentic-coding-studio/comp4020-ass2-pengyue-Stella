---
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import SessionsGrid from "../../components/SessionsGrid.astro";
import { sessionLabels, siteConfig } from "../../site-config";
import "../../styles/scientific.css";
---

<ContentLayout
  title={sessionLabels.plural}
  description="Twelve teaching modules across four stages: measuring edible matter, then its structures, its transformations under cooking, and finally how to predict and design it."
  {...siteConfig}
>
  <p>
    Each stage builds on the last — Stage 2 assumes the vocabulary Stage 1
    built, and so on through Stage 4. Read them in order the first time; use
    the module pager and the links below each module to move forward or back
    once you know the ground.
  </p>
  <SessionsGrid />
</ContentLayout>
